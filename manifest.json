{
  "manifest_version": 3,
  "name": "Canvas To-Do",
  "version": "1.2.0",
  "description": "Turn Canvas assignments into an interactive to-do list using your logged-in browser session.",
  "permissions": ["storage", "activeTab", "system.display", "webRequest"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Canvas To-Do"
  }
}
